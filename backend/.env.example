# Server Port Configuration
PORT=5000

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Turso (libSQL) Database Configuration
# In production (Railway/Render), supply your Turso database URL and Auth Token.
# In local development, leaving TURSO_DATABASE_URL unset automatically falls back to local SQLite.
TURSO_DATABASE_URL=your_turso_database_url
TURSO_AUTH_TOKEN=your_turso_auth_token

# Authentication Security (Generate a cryptographically strong secret for production)
JWT_SECRET=your_jwt_secret_key_here

# Single Administrator Account Configuration
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password
